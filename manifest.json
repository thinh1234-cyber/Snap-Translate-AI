{
  "manifest_version": 3,
  "name": "Snap Decode",
  "version": "2.1.0",
  "description": "Giải mã QR Code, VietQR thông minh và Mở khóa tải tài liệu Scribd, Studocu.",
  "key": "",
  "icons": {
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "action": {
    "default_title": "Snap Decode",
    "default_popup": "html/popup.html"
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "commands",
    "tabs",
    "notifications",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "snap-region": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Alt+X"
      },
      "description": "Kích hoạt Snap quét QR Code"
    }
  },
  "options_page": "html/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "css/content.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
