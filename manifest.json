{
  "manifest_version": 3,
  "name": "Snap & Translate AI",
  "version": "1.0.0",
  "description": "Chụp vùng màn hình (snap) và tự động trích xuất, dịch văn bản chuyên ngành bằng AI.",
  "icons": {
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "action": {
    "default_title": "Snap & Translate",
    "default_popup": "html/popup.html"
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "commands",
    "tabs",
    "notifications",
    "cookies",
    "webNavigation",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "downloads"
  ],
  "host_permissions": [
    "*://chatgpt.com/*",
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ruleset_chatgpt", "enabled": true, "path": "rules.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://chatgpt.com/*"],
      "js": ["js/chatgpt_automator.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "commands": {
    "snap-region": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Alt+X"
      },
      "description": "Kích hoạt chức năng chụp một vùng màn hình"
    }
  },
  "options_page": "html/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "css/content.css",
        "lib/tesseract.min.js",
        "lib/jsQR.js",
        "lib/worker.min.js",
        "lib/tesseract-core.wasm.js",
        "lib/lang-data/eng.traineddata.gz",
        "lib/lang-data/vie.traineddata.gz"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
