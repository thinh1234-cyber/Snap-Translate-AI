{
  "manifest_version": 3,
  "name": "Snap Decode - QR & DocUnlocker",
  "version": "2.2.0",
  "description": "Giải mã QR Code và Mở khóa tải tài liệu Scribd, Studocu, SlideShare.",
  "key": "",
  "icons": {
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "action": {
    "default_title": "Snap Decode",
    "default_popup": "html/popup.html"
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "commands",
    "tabs",
    "notifications",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "snap-region": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Alt+X"
      },
      "description": "Kích hoạt Snap quét QR Code"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.scribd.com/*",
        "*://*.studocu.com/*",
        "*://*.studocu.vn/*",
        "*://studocu.vn/*",
        "*://*.slideshare.net/*"
      ],
      "js": [
        "js/doc-unlocker/ui-overlay.js",
        "js/doc-unlocker/providers/scribd.js",
        "js/doc-unlocker/providers/studocu.js",
        "js/doc-unlocker/providers/slideshare.js",
        "js/doc-unlocker/index.js",
        "js/doc-inject.js"
      ],
      "run_at": "document_end"
    }
  ],
  "options_page": "html/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "css/content.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
